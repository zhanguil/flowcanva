# FlowCanva 环境变量配置
# 复制此文件为 .env 并修改

PORT=:6789
DB_PATH=./data.db
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# VectorEngine（仅后端读取，禁止下发到浏览器）
VECTORENGINE_BASE_URL=https://api.vectorengine.cn
VECTORENGINE_API_KEY=

# GPT-5.6 Sol 实际模型 ID 由部署环境填写
ASSISTANT_MODEL=

IMAGE_MODEL_FAST=gemini-3.1-flash-image-preview
IMAGE_MODEL_PRO=gemini-3-pro-image-preview
IMAGE_MODEL_EDIT=gpt-image-2
