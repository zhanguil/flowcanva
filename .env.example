# FlowCanva 环境变量配置
# 复制此文件为 .env 并修改

SERVER_HOST=0.0.0.0
PORT=6789
DB_PATH=./data.db
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# Vite 开发服务器与服务端代理目标（仅开发模式）
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_ADMIN_PORT=5174
# 可选；留空时自动使用本机主机名连接后端，仅供 Vite 服务端代理使用
VITE_API_TARGET=

# VectorEngine（仅后端读取，禁止下发到浏览器）
VECTORENGINE_BASE_URL=https://api.vectorengine.cn
VECTORENGINE_API_KEY=

# GPT-5.6 Sol 实际模型 ID 由部署环境填写
ASSISTANT_MODEL=

IMAGE_MODEL_FAST=gemini-3.1-flash-image-preview
IMAGE_MODEL_PRO=gemini-3-pro-image-preview
IMAGE_MODEL_EDIT=gpt-image-2
